# MINDLET 환경 변수 예시 (예시 값만 들어 있습니다)
# 사용법: 이 파일을 .env.local 로 복사한 뒤 자신의 값으로 바꾸세요. .env.local 은 Git 에 올라가지 않습니다.
# Vercel 에는 아래 5개를 Project Settings > Environment Variables 에 그대로 등록합니다.

# Supabase 연결 (공개 가능한 값)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# 서버 전용 비밀값 (NEXT_PUBLIC_ 를 붙이지 마세요)
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# 관리자 암호의 bcrypt 해시: npm run hash-admin 으로 생성합니다.
# 주의: .env.local 에서는 해시 안의 $ 를 \$ 로 바꿔 써야 합니다(스크립트가 그 형태도 출력).
#       Vercel 대시보드에는 $ 를 그대로(이스케이프 없이) 입력합니다.
ADMIN_PASSWORD_HASH=YOUR_BCRYPT_HASH

# 32자 이상 무작위 문자열: npm run gen-session-secret 으로 생성합니다.
ADMIN_SESSION_SECRET=YOUR_LONG_RANDOM_SESSION_SECRET
